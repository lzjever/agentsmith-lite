{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/agentsmith-lite-next.tsbuildinfo",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/endpoints-members-935095/types/**/*.ts",
    ".next/endpoints-members-935095/dev/types/**/*.ts",
    ".next/endpoints-members-945711/types/**/*.ts",
    ".next/endpoints-members-945711/dev/types/**/*.ts",
    ".next/endpoints-members-950007/types/**/*.ts",
    ".next/endpoints-members-950007/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
